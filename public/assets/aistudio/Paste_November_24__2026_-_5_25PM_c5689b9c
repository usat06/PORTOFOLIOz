  <style>
    :root{--paper:#f4f1eb;--ink:#252522;--muted:#77756e;--line:#d9d5cd;--accent:#8b6b51}
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:"DM Sans",sans-serif}
    button,input,select,textarea{font-family:"DM Sans",sans-serif}
    button,a{-webkit-tap-highlight-color:transparent}
    a{color:inherit;text-decoration:none}
    button{cursor:pointer}
    :focus-visible{outline:2px solid var(--accent);outline-offset:4px}
    .site-header{height:86px;display:flex;align-items:center;justify-content:space-between;padding:0 5.5%;background:var(--paper);position:relative;z-index:10}
    .brand{font-family:"Playfair Display",serif;font-size:25px;letter-spacing:-.055em;white-space:nowrap}
    .brand span{color:var(--accent)}
    .nav{display:flex;align-items:center;gap:42px}
    .nav a{font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;transition:color .2s}
    .nav a:hover,.footer-link:hover{color:var(--accent)}
    .menu-toggle{display:none;border:0;background:none;padding:8px;color:var(--ink)}
    .menu-toggle svg{width:24px;height:24px}
    .hero{min-height:680px;height:calc(100vh - 86px);max-height:920px;position:relative;overflow:hidden;background:#323b39;color:white}
    .hero img{width:100%;height:100%;object-fit:cover;display:block}
    .hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(15,23,25,.62) 0%,rgba(15,23,25,.18) 65%,rgba(15,23,25,.08) 100%),linear-gradient(0deg,rgba(8,16,17,.24),transparent 48%)}
    .hero-content{position:absolute;z-index:1;left:9%;top:50%;transform:translateY(-42%);max-width:700px}
    .eyebrow{font-size:11px;font-weight:700;letter-spacing:.25em;text-transform:uppercase}
    .hero .eyebrow{display:flex;align-items:center;gap:15px}
    .hero .eyebrow:before{content:"";width:35px;height:1px;background:currentColor}
    h1,h2,h3,p{margin-top:0}
    h1,h2,.statement{font-family:"Playfair Display",serif;font-weight:400}
    h1{font-size:clamp(60px,8.6vw,138px);line-height:1.03;letter-spacing:-.055em;margin:25px 0 27px}
    .hero-content p{font-size:16px;line-height:1.8;max-width:390px;color:#eeeae5}
    .hero-link{display:inline-flex;align-items:center;gap:20px;margin-top:34px;padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,.75);font-size:11px;font-weight:700;letter-spacing:.19em;text-transform:uppercase}
    .hero-link svg{width:18px;height:18px;transition:transform .2s}
    .hero-link:hover svg{transform:translateX(5px)}
    .hero-index{position:absolute;z-index:1;bottom:34px;left:5.5%;font-size:11px;letter-spacing:.18em}
    .hero-side{position:absolute;z-index:1;right:5.5%;bottom:34px;font-size:11px;letter-spacing:.18em;text-transform:uppercase}
    .section-shell{max-width:1500px;margin:auto;padding:0 5.5%}
    .work{padding:125px 0 145px}
    .section-top{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:52px}
    .section-top .eyebrow,.about .eyebrow,.contact .eyebrow{color:var(--accent)}
    h2{font-size:clamp(46px,5.6vw,84px);letter-spacing:-.055em;line-height:1.12;margin:17px 0 0}
    .section-note{max-width:250px;color:var(--muted);font-size:13px;line-height:1.8;margin:0 0 7px}
    .filters{display:flex;flex-wrap:wrap;gap:12px 31px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:21px 0;margin-bottom:42px}
    .filter{border:0;background:none;padding:5px 0;color:#87847d;font-size:11px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;position:relative}
    .filter:hover,.filter.active{color:var(--ink)}
    .filter.active:after{content:"";position:absolute;bottom:-22px;left:0;right:0;height:2px;background:var(--ink)}
    .gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:62px 28px}
    .work-card{min-width:0}
    .work-card[hidden]{display:none}
    .photo-button{border:0;padding:0;width:100%;display:block;background:#d9d5cd;overflow:hidden;text-align:left}
    .photo-button img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .55s ease}
    .photo-button:hover img{transform:scale(1.035)}
    .work-card:nth-child(1) .photo-button,.work-card:nth-child(4) .photo-button{aspect-ratio:1.12}
    .work-card:nth-child(2) .photo-button,.work-card:nth-child(3) .photo-button{aspect-ratio:.82}
    .work-card:nth-child(5) .photo-button,.work-card:nth-child(6) .photo-button{aspect-ratio:1.05}
    .work-meta{display:flex;justify-content:space-between;gap:16px;align-items:baseline;padding-top:18px}
    .work-meta h3{font-family:"Playfair Display",serif;font-weight:400;font-size:25px;letter-spacing:-.025em;margin:0}
    .work-meta span{font-size:10px;text-transform:uppercase;letter-spacing:.17em;color:var(--muted);white-space:nowrap}
    .about{background:#eae6dd;padding:125px 0}
    .about-inner{display:grid;grid-template-columns:1fr 1.25fr;gap:10%;align-items:start}
    .about h2{margin-bottom:0}
    .about-copy{padding-top:20px}
    .statement{font-size:clamp(27px,3vw,43px);line-height:1.4;letter-spacing:-.025em;margin-bottom:31px}
    .about-copy>p:last-child{max-width:540px;color:#68665f;font-size:15px;line-height:1.9;margin:0}
    .contact{padding:135px 0 145px;text-align:center}
    .contact h2{max-width:810px;margin:20px auto 25px}
    .contact p{color:var(--muted);font-size:15px;line-height:1.8;margin-bottom:38px}
    .email-link{display:inline-flex;align-items:center;gap:23px;font-family:"Playfair Display",serif;font-size:clamp(23px,3vw,39px);letter-spacing:-.025em;border-bottom:1px solid var(--ink);padding-bottom:11px}
    .email-link svg{width:25px;height:25px}
    .email-link:hover{color:var(--accent);border-color:var(--accent)}
    footer{border-top:1px solid var(--line);padding:30px 5.5%;display:flex;align-items:center;justify-content:space-between;gap:20px;color:var(--muted);font-size:11px;letter-spacing:.08em}
    footer .brand{font-size:19px;color:var(--ink)}
    .footer-link{text-transform:uppercase;font-weight:700;letter-spacing:.15em}
    .lightbox{position:fixed;inset:0;z-index:30;background:rgba(19,19,18,.96);display:none;align-items:center;justify-content:center;padding:70px 5% 50px}
    .lightbox.open{display:flex}
    .lightbox-content{max-width:min(1100px,100%);max-height:100%;display:flex;flex-direction:column;align-items:center;gap:17px}
    .lightbox img{display:block;max-width:100%;max-height:calc(100vh - 145px);object-fit:contain}
    .lightbox-caption{color:#eee;font-size:12px;letter-spacing:.13em;text-align:center;text-transform:uppercase}
    .lightbox-close{position:absolute;right:32px;top:27px;color:white;border:0;background:none;padding:10px}
    .lightbox-close svg{width:27px;height:27px}
    @media(max-width:760px){
      .site-header{height:72px;padding:0 6%}
      .brand{font-size:23px}
      .menu-toggle{display:block}
      .nav{display:none;position:absolute;top:72px;left:0;right:0;background:var(--paper);padding:25px 6% 32px;box-shadow:0 14px 20px rgba(0,0,0,.08);flex-direction:column;align-items:flex-start;gap:26px}
      .nav.open{display:flex}
      .hero{height:720px;min-height:0;max-height:calc(100svh - 72px)}
      .hero img{object-position:58% center}
      .hero-content{left:7%;right:7%;transform:translateY(-34%)}
      h1{font-size:clamp(58px,12vw,90px)}
      .hero-side{display:none}
      .hero-index{left:7%}
      .section-shell{padding:0 6%}
      .work{padding:85px 0 95px}
      .section-top{display:block;margin-bottom:35px}
      .section-note{margin-top:20px}
      .gallery{gap:38px 18px}
      .work-meta{display:block}
      .work-meta h3{font-size:20px;margin-bottom:7px}
      .about{padding:85px 0}
      .about-inner{grid-template-columns:1fr;gap:27px}
      .about-copy{padding:0}
      .contact{padding:95px 0 105px}
    }
    @media(max-width:540px){
      .gallery{grid-template-columns:1fr;gap:40px}
      .work-card .photo-button{aspect-ratio:1.08!important}
      .filters{gap:13px 22px}
      .filter.active:after{bottom:-8px}
      footer{flex-wrap:wrap}
      footer .brand{width:100%}
    }
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
  </style>
